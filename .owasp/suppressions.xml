<?xml version="1.0" encoding="UTF-8"?>
<!--
  ~ OWASP dependency-check false-positive / accepted-risk suppressions.
  ~
  ~ Only the `mvn -Powasp ...` profile reads this file. Add an entry here when the scan
  ~ flags a CVE that does not apply (wrong artifact match) or an accepted risk. Prefer the
  ~ narrowest match (specific package + specific source), and always leave a dated note.
  ~
  ~ Docs: https://dependency-check.github.io/DependencyCheck/general/suppression.html
  -->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- ============================================================================
         Flink web dashboard — bundled front-end assets (false positives)

         org.apache.flink:flink-runtime-web ships Flink's browser dashboard as minified
         JavaScript inside the jar (flink-runtime-web-<v>.jar/web/*.js). dependency-check's
         RetireJS analyzer fingerprints those bundles and reports CVEs against the JS
         libraries they were built from (DOMPurify, @angular/core).

         These are NOT on flink-generic's JVM runtime classpath and are not part of any
         artifact this project ships or executes. They belong to Flink's dashboard, served
         by the cluster's JobManager. Patching them is Apache Flink's responsibility, tracked
         by upgrading Flink. Each entry is double-scoped (source jar AND package URL) so it
         only fires for the bundle inside flink-runtime-web.
         ============================================================================ -->

    <suppress>
        <notes><![CDATA[
            False positive for this library. DOMPurify is a minified JS asset bundled inside
            org.apache.flink:flink-runtime-web (Flink's web dashboard UI), not a dependency
            flink-generic runs or ships. Fix rides on future Flink upgrades. Reviewed 2026-07-26.
        ]]></notes>
        <filePath regex="true">.*flink-runtime-web-.*\.jar.*</filePath>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
    </suppress>

    <suppress>
        <notes><![CDATA[
            False positive for this library. @angular/core here is minified JS bundled inside
            org.apache.flink:flink-runtime-web (Flink's web dashboard UI), not a dependency
            flink-generic runs or ships. Fix rides on future Flink upgrades. Reviewed 2026-07-26.
        ]]></notes>
        <filePath regex="true">.*flink-runtime-web-.*\.jar.*</filePath>
        <packageUrl regex="true">^pkg:javascript/%40angular%2Fcore@.*$</packageUrl>
    </suppress>

    <!-- Example (disabled) — copy, adjust, and document before enabling:
    <suppress>
        <notes><![CDATA[
            CVE-XXXX-YYYYY does not apply: <reason>. Reviewed <name> <date>.
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.example/some-artifact@.*$</packageUrl>
        <cve>CVE-XXXX-YYYYY</cve>
    </suppress>
    -->

</suppressions>
